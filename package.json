{
  "name": "asma-hammami-portfolio",
  "version": "5.1.0",
  "private": true,
  "description": "Asma Hammami editorial portfolio built with Tailwind CSS, Webpack and GSAP",
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production && node scripts/generate-seo.js",
    "preview": "webpack serve --mode production --open",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.3",
    "postcss": "^8.5.3",
    "postcss-loader": "^8.1.1",
    "style-loader": "^4.0.0",
    "tailwindcss": "3.4.17",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0",
    "copy-webpack-plugin": "^12.0.2"
  },
  "dependencies": {
    "gsap": "^3.13.0"
  }
}
